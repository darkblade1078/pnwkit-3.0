{
  "name": "pnwkit-3.0",
  "version": "4.3.0",
  "description": "The 3.0 version of the PnWKit library.",
  "license": "MIT",
  "author": "Darkblade",
  "keywords": [
    "politics-and-war",
    "politicsandwar",
    "pnw",
    "graphql",
    "api",
    "api-wrapper",
    "sdk",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkblade1078/pnwkit-3.0.git"
  },
  "homepage": "https://darkblade1078.github.io/pnwkit-3.0",
  "bugs": {
    "url": "https://github.com/darkblade1078/pnwkit-3.0/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "lint": "eslint src",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/papaparse": "^5.5.2",
    "eslint": "^10.8.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "crc-32": "^1.2.2",
    "fflate": "^0.8.3",
    "lru-cache": "^11.2.4",
    "papaparse": "^5.5.4",
    "pusher-js": "^8.4.0",
    "ws": "^8.19.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
