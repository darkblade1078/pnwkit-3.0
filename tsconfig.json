{
  // https://aka.ms/tsconfig
  // tsc is used for type-checking only (`npm run typecheck`); tsup handles the
  // actual build/emit, which is why imports can be written without a .js extension.
  "compilerOptions": {
    // Modern Node ESM library, bundled by tsup
    "module": "preserve",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "noEmit": true,

    // tsup's .d.ts bundler injects the (now-deprecated) baseUrl option; silence
    // the TS 6.0 deprecation so the declaration build succeeds.
    "ignoreDeprecations": "6.0",

    // Type safety
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // Module hygiene
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noUncheckedSideEffectImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "**/*.test.ts"]
}
